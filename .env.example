# MLR RuleOps environment
# Copy to .env: cp .env.example .env

APP_NAME=MLR RuleOps
APP_ENV=demo
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET=change-me-jwt-secret-use-a-long-random-string
JWT_EXPIRY_MINUTES=480
JWT_ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+psycopg://ruleops:ruleops@postgres:5432/ruleops
# Host-side (non-docker) example — compose maps Postgres to localhost:5433
# DATABASE_URL=postgresql+psycopg://ruleops:ruleops@localhost:5433/ruleops

# Redis
REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://localhost:8081,http://52.0.130.62:8081

# LLM — openai | azure_openai | anthropic | bedrock | deterministic
LLM_PROVIDER=deterministic
LLM_CONFIDENCE_THRESHOLD=0.72

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AWS Bedrock (no API keys — uses `aws configure` / ~/.aws like aws_agent.py)
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Integrations — leave empty to remain NOT_CONFIGURED
SERVICENOW_BASE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Seed
SEED_REVIEWS=200
SEED_ON_STARTUP=true

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_SSE_BASE_URL=http://localhost:8000
